config wifi-device 'radio0'
        option type 'mac80211'
        option path 'platform/soc/d0000000.apb/d0070000.mmc/mmc_host/mmc2/mmc2:0001/mmc2:0001:1'
        option channel '1'
        option band '2g'
        option htmode 'NOHT'

config wifi-iface 'default_radio0'
        option device 'radio0'
        option network 'lan'
        option mode 'ap'
        option ssid 'Funlight'
        option encryption 'psk2'
        option key 'funlight'
